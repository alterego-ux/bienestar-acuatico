{
  "name": "bienestar-acuatico-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API REST (Node.js + Express + PostgreSQL) para el prototipo académico Bienestar Acuático · Metodología ICA v2.0 (2024). No es un sistema oficial del ICA.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js",
    "export:catalogo": "node scripts/exportar-catalogo.js",
    "test": "node --test \"tests/*.test.js\"",
    "ensure": "node src/db/ensure.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
