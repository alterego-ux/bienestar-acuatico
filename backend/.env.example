# ---- Servidor ----
# 4100 para no chocar con el proyecto anterior (4000). Angular (4200) le hace proxy en /api.
PORT=4100
NODE_ENV=development

# ---- Base de datos PostgreSQL ----
# OPCIÓN A · PostgreSQL local o Docker (por defecto):
# docker compose up -d db  → PostgreSQL propio del proyecto nuevo en el puerto 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bienestar_ejecutivo

# OPCIÓN B · Supabase (PostgreSQL en la nube). Comenta la línea de arriba y usa ésta.
#   Supabase → botón "Connect" → "Session pooler" → copia la cadena (funciona en redes IPv4).
#   Si tu clave tiene símbolos (@ # / : ?) debes codificarlos (ej. @ → %40).
# DATABASE_URL=postgres://postgres.TU_PROJECT_REF:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# SSL: vacío = automático (se activa solo con Supabase/Neon/Render/Railway).
# Pon true o false para forzarlo.
PGSSL=

# Alternativa si prefieres variables sueltas (se usan solo si DATABASE_URL está vacío)
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bienestar_ejecutivo

# ---- Gemini API · opcional, solo backend ----
# Obtén la clave desde Google AI Studio y NO la copies al frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_MESSAGE_CHARS=2000
GEMINI_RATE_LIMIT_PER_MINUTE=12

# ---- Seguridad ----
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRA=8h

# ---- CORS ----
# En desarrollo Angular usa proxy (/api), por lo que no hay CORS. Orígenes permitidos si llamas
# a la API directamente (separados por coma).
CORS_ORIGEN=http://localhost:4200,http://127.0.0.1:4200

# ---- Evidencias ----
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15

# ---- Supabase Storage · solo backend (no incluir claves en Angular) ----
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR_EN_RENDER_Y_BACKEND_ENV
SUPABASE_STORAGE_BUCKET=evidencias

# ---- Modo sin conexión en el frontend ----
MODO_OFFLINE_PERMITIDO=true
