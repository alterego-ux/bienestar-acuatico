# Configuración para ejecutar el backend directamente en el computador.
# Para Docker Compose, usa el archivo .env de la raíz del proyecto.
PORT=4100
NODE_ENV=development

# PostgreSQL local: ajusta el usuario/clave según tu instalación.
DATABASE_URL=postgres://bienestar:cambia_esta_clave@localhost:5433/bienestar_acuatico
PGSSL=false
PGHOST=localhost
PGPORT=5433
PGUSER=bienestar
PGPASSWORD=cambia_esta_clave
PGDATABASE=bienestar_acuatico

# Gemini (opcional). La clave solo va en el backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_MESSAGE_CHARS=2000
GEMINI_RATE_LIMIT_PER_MINUTE=12

# Seguridad: reemplaza este valor por un secreto largo y aleatorio.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRA=8h

# En desarrollo Angular usa proxy /api hacia el backend.
CORS_ORIGEN=http://localhost:4200

UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15

# Supabase Storage (opcional, necesario para nuevas evidencias).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidencias
STORAGE_DRIVER=auto

MODO_OFFLINE_PERMITIDO=true
