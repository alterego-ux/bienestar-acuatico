# Copia este archivo como .env antes de ejecutar Docker Compose.
# No subas el archivo .env real a GitHub.

POSTGRES_DB=bienestar_acuatico
POSTGRES_USER=bienestar
POSTGRES_PASSWORD=cambia_esta_clave_local_2026
DB_HOST_PORT=5433
WEB_HOST_PORT=8080

# Usa una clave larga, aleatoria y exclusiva para este entorno.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRA=8h

# Opcionales: deja vacíos si aún no vas a utilizar estas funciones.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_MESSAGE_CHARS=2000
GEMINI_RATE_LIMIT_PER_MINUTE=12

# Supabase Storage se utiliza para guardar evidencias.
# Completa estos valores si vas a cargar/consultar evidencias.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidencias
# auto = Supabase si está configurado y, si falla, disco local (volumen Docker).
# local = sin Supabase, todo queda dentro de Docker. supabase = solo Supabase.
STORAGE_DRIVER=auto

CORS_ORIGEN=http://localhost:8080
MAX_UPLOAD_MB=15
MODO_OFFLINE_PERMITIDO=false
